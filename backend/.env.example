# NEREUS backend configuration. Copy to ".env" to override defaults. No secrets are needed.

# Inference engine: "demo" (classical CV fallback) or "yolo" (trained model, see README).
MODEL_TYPE=demo
# Path to trained weights when MODEL_TYPE=yolo (relative paths resolve from backend/).
MODEL_PATH=models/nereus_yolo.pt
# Maximum upload size in megabytes.
MAX_UPLOAD_MB=25
# Longest image side (pixels) used for processing. Larger images are downscaled, aspect ratio preserved.
MAX_PROCESSING_DIM=1600
# Comma-separated list of allowed browser origins (CORS).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SQLite database file and output folder (relative to backend/).
DATABASE_PATH=outputs/nereus.db
OUTPUT_DIR=outputs
# Detections below this confidence (0-100) are dropped after noise filtering.
MIN_CONFIDENCE=35
# Milliseconds each pipeline stage stays visible in the UI so stages are legible in a demo. 0 = full speed.
STAGE_PACING_MS=450
# Assumed metres per pixel when survey metadata does not provide one (dimensions are then labelled "assumed").
DEFAULT_PIXEL_SIZE_M=0.10
# Reference position for clearly-labelled DEMO coordinates when a scan has no metadata.
DEMO_LATITUDE=13.0600
DEMO_LONGITUDE=80.3300
DEMO_HEADING_DEG=90
